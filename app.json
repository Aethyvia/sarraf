{
  "expo": {
    "name": "Sarraf",
    "slug": "sarraf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.aethyvia.sarraf",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-font",
      "expo-splash-screen",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing"
    ],
    "scheme": "sarraf",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "aethyvia",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "035a2fc8-adc9-4896-9211-23dfb7b8962e"
      }
    }
  }
}
